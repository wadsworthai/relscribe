{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-taskrail-version.sh 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Checking for a newer taskrail release"
          }
        ]
      }
    ]
  }
}
